{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LeagueStatTracker",
  "version": "0.2.0",
  "identifier": "com.leaguestat.tracker",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "League of Legends Stat Tracker",
        "width": 1560,
        "height": 920,
        "minWidth": 1100,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$VIDEO/**",
          "$VIDEO/**/*",
          "**"
        ]
      }
    }
  },
  "plugins": {
    "opener": {},
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEwQjFGOUNBQkEyQUFBRkYKUldUL3FpcTZ5dm14RUo0WnJ2bU9UQTFUb3dCNUVJckRadzZoY1hJQkgrbTI5aEdCT0FOZ1kwdWwK",
      "endpoints": [
        "https://github.com/LNewell00/LeagueStatTracker/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "createUpdaterArtifacts": true
  }
}
